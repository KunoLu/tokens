{
  "name": "@tokens/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cp ../install.sh public/install.sh && cp ../pre-install-tokens.sh ../pre-install-tokens.ps1 public/ && mkdir -p public/clients && cp ../.github/assets/client-* public/clients/ && next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",

    "test:migrations": "drizzle-kit migrate && bun scripts/check-migrations.ts",
    "test:teams": "bun scripts/check-teams-invariants.ts",



    "gallery": "bun scripts/gallery/build-gallery.ts",
    "generate:embed-logos": "bun scripts/generate-embed-logos.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"

  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@lobehub/icons-static-svg": "^1.94.0",

    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.3",
    "lucide-react": "^1.26.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "obelisk.js": "^1.2.2",
    "postgres": "^3.4.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-toastify": "^11.0.5",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "typescript": "^5"

  }
}
