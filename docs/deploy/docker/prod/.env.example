# tokens prod stack — copy to `.env` beside docker-compose.yml and fill in.
# 所有值都是占位符：全部要改，勿直接用占位值上线。

# --- Postgres (container-internal only; never exposed to the host) ----------
POSTGRES_USER=tokens
POSTGRES_DB=tokens
# 随机长串。DATABASE_URL 里的密码必须与它一致。
POSTGRES_PASSWORD=change-me-long-random

# --- Web runtime -------------------------------------------------------------
# 指向 compose 内 postgres 服务（主机名就是服务名，端口 5432）。
DATABASE_URL=postgresql://tokens:change-me-long-random@postgres:5432/tokens
# compose 内网 Postgres 无 TLS 用 disable；数据库有 TLS 时改 require。
DATABASE_SSL=disable
# 你的站点源（https://你的域名）。device 授权链接、验证信、邀请链接、
# OG 卡片与 CSRF Origin 白名单全部由它派生，必须与反代对外地址一致。
NEXT_PUBLIC_URL=https://your-domain.example
# 每日维护端点 /api/cron/refresh-social-links 的 Bearer 密钥，随机长串。
CRON_SECRET=change-me-long-random

# --- Optional ----------------------------------------------------------------
# 法律页联系邮箱；不配置则法律页只显示站点链接，不渲染 mailto。
# CONTACT_EMAIL=ops@your-domain.example
# Resend 邮件（注册验证 / 邀请）。不配置则发信只打日志并跳过：
# 注册/找回仍可用，但按邮箱的 Team 邀请事实上不可用。
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Tokens <noreply@your-domain.example>
